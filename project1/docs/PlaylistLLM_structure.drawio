<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="1. System Structure" id="page-structure">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title1" value="Podify — where PlaylistLLM sits  (owner: Dochan Moon)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="fileIn" value="&lt;b&gt;llm_playlist.csv&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM-generated catalog&lt;br&gt;id,title,artist,&lt;br&gt;duration,genre,playCount" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="fileOut" value="&lt;b&gt;saved_playlist.csv&lt;/b&gt;&lt;br&gt;&lt;br&gt;written by the program&lt;br&gt;so play counts survive&lt;br&gt;closing the app" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="&lt;div style=&quot;text-align:center;font-size:16px;&quot;&gt;&lt;b&gt;PlaylistLLM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;color:#444;&quot;&gt;reads / writes the CSV file&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;State&lt;/b&gt;&lt;br&gt;- importedSongs : ArrayList of Song&lt;br&gt;- lastError : String&lt;br&gt;- damagedRows : int&lt;br&gt;- duplicateRows : int&lt;br&gt;- MAX_TEXT_LENGTH = 30&lt;br&gt;- HEADER : String&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Read&lt;/b&gt;&lt;br&gt;+ loadSongs(String) : boolean&lt;br&gt;&lt;br&gt;&lt;b&gt;Write&lt;/b&gt;&lt;br&gt;+ saveSongs(String, List) : boolean&lt;br&gt;+ savePlaylist(String, UserPlaylist) : boolean&lt;br&gt;&lt;br&gt;&lt;b&gt;Look up&lt;/b&gt;&lt;br&gt;+ searchSongs(String) : List of Song&lt;br&gt;+ getSong(String) : Song&lt;br&gt;+ getSongById(String) : Song&lt;br&gt;+ getImportedSongs() : List of Song&lt;br&gt;+ numberImportedSongs() : int&lt;br&gt;&lt;br&gt;&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;+ getLastError() : String&lt;br&gt;+ getSkippedRows() : int&lt;br&gt;+ getDamagedRows() : int&lt;br&gt;+ getDuplicateRows() : int&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="330" height="560" as="geometry" />
        </mxCell>

        <mxCell id="song" value="&lt;div style=&quot;text-align:center;font-size:15px;&quot;&gt;&lt;b&gt;Song&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;color:#444;&quot;&gt;Miguel&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;- id, name, artist,&lt;br&gt;&amp;nbsp;&amp;nbsp;duration, genre : String&lt;br&gt;- playCount : int&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;+ getId() / getName() /&lt;br&gt;&amp;nbsp;&amp;nbsp;getArtist() / getDuration() /&lt;br&gt;&amp;nbsp;&amp;nbsp;getGenre() / getPlayCount()&lt;br&gt;+ play() : int&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="290" height="210" as="geometry" />
        </mxCell>

        <mxCell id="playlist" value="&lt;div style=&quot;text-align:center;font-size:15px;&quot;&gt;&lt;b&gt;UserPlaylist&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;color:#444;&quot;&gt;Suhana&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;- songs : ArrayList of Song&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;+ addSong(Song) / removeSong(Song)&lt;br&gt;+ search(Song) : boolean&lt;br&gt;+ getSongs() : List of Song&lt;br&gt;+ numberSongs() / lessThanSix()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="380" width="290" height="180" as="geometry" />
        </mxCell>

        <mxCell id="ranking" value="&lt;div style=&quot;text-align:center;font-size:15px;&quot;&gt;&lt;b&gt;Ranking&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;color:#444;&quot;&gt;Daphne&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;+ rankSongs() / showTop() /&lt;br&gt;&amp;nbsp;&amp;nbsp;showBottom() / showFull()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="620" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="loadSongs() reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="fileIn" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="saveSongs() writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="llm" target="fileOut">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="creates one Song&#10;per valid row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="llm" target="song">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="savePlaylist() calls&#10;getSongs()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="llm" target="playlist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="stores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="playlist" target="song">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="ranks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ranking" target="playlist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;Key point&lt;/b&gt;&lt;br&gt;PlaylistLLM never changes UserPlaylist.&lt;br&gt;It only turns a file into Song objects,&lt;br&gt;and turns Song objects back into a file.&lt;br&gt;The user picks songs from the catalog;&lt;br&gt;UserPlaylist is what stores them." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Why ArrayList for importedSongs?&lt;/b&gt;&lt;br&gt;1. It keeps the songs in the same order as the file.&lt;br&gt;2. The console menu shows a numbered list, so we need&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;to reach a song by index — get(i) is instant.&lt;br&gt;3. The catalog is read once and then only searched,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;so the slow part of ArrayList (inserting in the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;middle) never happens here." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="420" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
